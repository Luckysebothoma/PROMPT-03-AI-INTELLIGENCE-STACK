# ============================================================
# AI GATEWAY - DAY 5 - AI INTELLIGENCE STACK
# Bootstrap configuration (.env). Copy to .env and edit.
# The deployment script will NEVER overwrite an existing .env.
# ============================================================

PORT=8080
NODE_ENV=production

# ------------------------------------------------------------
# Upstream stacks (DO NOT rebuild/remove - Day 5 only consumes them)
# From inside the day5-app container, 127.0.0.1/localhost refers to the
# container itself. Use host.docker.internal (Docker Desktop) or the
# host's LAN IP to reach Day 3 / Day 4 running on the host, or the
# service name if they are joined onto the same docker network.
# ------------------------------------------------------------
DAY3_URL=http://192.168.0.140:4405
DAY4_URL=http://127.0.0.1:4406

# ------------------------------------------------------------
# PostgreSQL (durable registry)
# ------------------------------------------------------------
POSTGRES_HOST=day5-postgres
POSTGRES_PORT=5432
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=ai_gateway_password
POSTGRES_DB=ai_gateway_day5

# ------------------------------------------------------------
# Redis (runtime cache, not authoritative)
# ------------------------------------------------------------
REDIS_HOST=day5-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# Orchestration bounds
# ------------------------------------------------------------
MAX_ORCHESTRATION_DEPTH=3

# ------------------------------------------------------------
# Provider credentials (never returned by any API)
# ------------------------------------------------------------
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Back-compat single-key aliases some tooling expects
GROQ_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------
# Registry overrides (optional). If unset, sane defaults matching
# the Day 5 specification are used (see src/config.js).
# Must be valid JSON arrays or the app will FAIL FAST on boot.
# ------------------------------------------------------------
# AI_PROVIDERS_JSON=[{"id":"groq","enabled":true,"priority":10,"weight":100,"api_type":"openai-compatible","authentication_env":"GROQ_API_KEY"}]
# AI_MODELS_JSON=[{"provider":"groq","model":"openai/gpt-oss-120b","enabled":true,"priority":10,"weight":100,"lifecycle":"stable","capabilities":["chat","reasoning"],"modalities":["text"]}]
# AI_WORKERS_JSON=[{"id":"chat-worker","enabled":true,"priority":10,"weight":100,"provider":"groq","model":"openai/gpt-oss-120b","capabilities":["chat"],"temperature":0.5,"max_tokens":1000,"status":"active"}]
# AI_CREDENTIALS_JSON=[{"provider":"groq","credentials":[{"id":"groq-primary","enabled":true,"priority":10,"weight":100,"secret_env":"GROQ_API_KEY_1"}]}]
